diff --git a/app/globals.css b/app/globals.css
index 7a20f46..ad0c0a2 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -2992,3 +2992,185 @@
   scrollbar-width: thin;
   scrollbar-color: var(--primary) var(--secondary);
 }
+
+
+
+/* ─────────────────────────────────────────────────────────────
+   CCNA LAB SURFACES
+   Shared by every interactive lab. Uses semantic theme tokens,
+   so all eight themes and their dark variants work automatically.
+   ───────────────────────────────────────────────────────────── */
+
+.ccna-lab {
+  --lab-code-bg: color-mix(in srgb, var(--muted) 72%, transparent);
+  display: grid;
+  gap: 1rem;
+  min-width: 0;
+  max-width: 100%;
+  color: var(--foreground);
+  font-family: ui-sans-serif, system-ui, sans-serif;
+}
+
+.ccna-lab :where(h2, h3, h4) {
+  color: var(--foreground);
+}
+
+.ccna-lab :where(p, li) {
+  line-height: 1.65;
+}
+
+.ccna-lab :where(code, kbd, samp) {
+  color: var(--primary);
+  background: var(--lab-code-bg);
+  border: 1px solid var(--border);
+  border-radius: 0.35rem;
+  padding: 0.08rem 0.32rem;
+  overflow-wrap: anywhere;
+}
+
+.ccna-lab :where(details.ccna-lab__panel, details) {
+  min-width: 0;
+  padding: 0.85rem 1rem;
+  color: var(--card-foreground);
+  background: var(--glass-bg, var(--card));
+  border: 1px solid var(--glass-border, var(--border));
+  border-radius: var(--radius, 0.75rem);
+  box-shadow: var(--glass-shadow, 0 2px 10px rgb(0 0 0 / 0.04));
+  transition: border-color 180ms ease, box-shadow 180ms ease, background 180ms ease;
+}
+
+.ccna-lab :where(details[open]) {
+  border-color: var(--primary);
+}
+
+.ccna-lab :where(summary) {
+  display: flex;
+  align-items: center;
+  gap: 0.55rem;
+  min-height: 1.8rem;
+  color: var(--foreground);
+  font-weight: 700;
+  cursor: pointer;
+  list-style: none;
+}
+
+.ccna-lab :where(summary::-webkit-details-marker) {
+  display: none;
+}
+
+.ccna-lab :where(summary)::before {
+  content: "+";
+  display: inline-grid;
+  place-items: center;
+  width: 1.35rem;
+  height: 1.35rem;
+  flex: 0 0 1.35rem;
+  color: var(--primary-foreground);
+  background: var(--primary);
+  border-radius: 0.35rem;
+  font-size: 0.9rem;
+  line-height: 1;
+}
+
+.ccna-lab :where(details[open] > summary)::before {
+  content: "−";
+}
+
+.ccna-lab__device {
+  min-width: 0;
+  overflow: hidden;
+  color: var(--card-foreground);
+  border-radius: var(--radius, 0.75rem);
+}
+
+.ccna-lab__device-header {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 0.5rem;
+  padding: 0.55rem 0.7rem;
+  color: var(--foreground);
+  background: var(--muted) !important;
+  border-bottom: 1px solid var(--border);
+  font: 700 0.78rem/1.4 ui-sans-serif, system-ui, sans-serif !important;
+}
+
+.ccna-lab__device-header > span:first-child {
+  color: var(--foreground);
+  letter-spacing: 0.035em;
+}
+
+.ccna-lab__device-commands {
+  background: color-mix(in srgb, var(--card) 88%, var(--muted));
+  color: var(--card-foreground);
+}
+
+.ccna-lab__device button {
+  cursor: pointer;
+  font-weight: 700;
+}
+
+.ccna-lab :where(table) {
+  width: 100%;
+  color: var(--foreground);
+  border-collapse: collapse;
+}
+
+.ccna-lab :where(th) {
+  color: var(--foreground);
+  background: var(--muted) !important;
+  font-weight: 700;
+  text-align: left;
+}
+
+.ccna-lab :where(td, th) {
+  border-color: var(--border) !important;
+}
+
+.ccna-lab :where(tbody tr) {
+  border-color: var(--border) !important;
+}
+
+.ccna-lab :where(tbody tr:nth-child(even)) {
+  background: color-mix(in srgb, var(--muted) 38%, transparent);
+}
+
+.ccna-lab :where(button:focus-visible, [role="button"]:focus-visible, summary:focus-visible) {
+  outline: 2px solid var(--ring);
+  outline-offset: 3px;
+}
+
+.ccna-lab .ccna-lab__device-header button {
+  border: 1px solid color-mix(in srgb, var(--primary) 30%, transparent);
+  box-shadow: 0 1px 2px rgb(0 0 0 / 0.12);
+}
+
+@media (hover: hover) {
+  .ccna-lab :where(details.ccna-lab__panel, details):hover {
+    border-color: var(--primary);
+  }
+}
+
+@media (max-width: 640px) {
+  .ccna-lab :where(details.ccna-lab__panel, details) {
+    padding: 0.7rem 0.75rem;
+  }
+
+  .ccna-lab__device-header {
+    align-items: flex-start;
+  }
+
+  .ccna-lab__device-header button {
+    min-height: 2rem;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .ccna-lab *,
+  .ccna-lab *::before,
+  .ccna-lab *::after {
+    transition-duration: 0.01ms !important;
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+  }
+}
